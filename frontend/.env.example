# MansooriKart frontend environment.
#
# Copy to `frontend/.env` and replace the placeholders. Everything here is compiled into the
# shipped JavaScript bundle and is readable by anyone who loads the site, so only public values
# belong in this file. Never place MONGO_URI, JWT_SECRET, a Google client secret, an SMTP
# password, a payment credential or any database credential in a VITE_ variable.
#
# This is the complete list the frontend reads: VITE_API_URL and VITE_GOOGLE_CLIENT_ID are
# inlined by `vite.config.ts`, and VITE_BACKEND_URL is used only by the dev server proxy.

# Base URL the browser calls. Leave as the relative default so the dev proxy and the deployed
# reverse proxy both work; set an absolute origin only when the API is on another host.
VITE_API_URL=/api/v1

# Public Google OAuth client id, ending in `.apps.googleusercontent.com`. It grants nothing on
# its own: the API verifies every Google credential server-side against the same id. Leaving it
# empty hides the Google button and leaves email and password sign-in working. Must match the
# backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Dev-server proxy target for /api requests. Defaults to http://localhost:5000.
VITE_BACKEND_URL=http://localhost:5000
