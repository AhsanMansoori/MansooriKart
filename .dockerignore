# Docker build context excludes.
#
# The backend image builds with `COPY backend backend` and the frontend image with
# `COPY frontend frontend`, so anything present in those directories reaches a build layer
# unless it is listed here. Credential material is therefore excluded by pattern rather than
# by exact path: a developer's local `.npmrc` or key file must never be able to enter an image.

# Version control and CI
.git
.github

# Dependencies
node_modules
frontend/node_modules
backend/node_modules

# Build output, coverage and caches
dist
build
frontend/dist
coverage
frontend/coverage
backend/coverage
backend/.cache

# Credentials and environment files, at any depth. Examples are excluded too: an image reads
# its real configuration from the environment, never from a file baked into the context.
**/.npmrc
**/.netrc
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
serviceAccount*.json

# Documentation and archives: history, not runtime input.
docs
infrastructure/kubernetes-archive
infrastructure/ci-archive
infrastructure/legacy-archive
infrastructure/docker/archive

# Local editor and agent state
frontend/dev-tools
.claude
.idea
.kombai
