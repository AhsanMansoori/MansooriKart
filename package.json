{
  "name": "mansoorikart",
  "displayName": "MansooriKart Workspace",
  "description": "MansooriKart frontend, admin, and backend workspace orchestration.",
  "license": "MIT",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=@mansoorikart/web",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=@mansoorikart/api",
    "dev:web": "npm run dev --workspace=@mansoorikart/web",
    "dev:admin": "npm run dev --workspace=@mansoorikart/admin",
    "dev:frontend": "npm run dev --workspace=@mansoorikart/frontend",
    "build": "npm run build --workspace=@mansoorikart/web",
    "build:api": "npm run build --workspace=@mansoorikart/api",
    "build:web": "npm run build --workspace=@mansoorikart/web",
    "build:admin": "npm run build --workspace=@mansoorikart/admin",
    "test": "npm run test:api",
    "test:api": "npm run test --workspace=@mansoorikart/api",
    "typecheck": "npm run typecheck:api",
    "typecheck:api": "npm run typecheck --workspace=@mansoorikart/api",
    "typecheck:web": "npm run typecheck --workspace=@mansoorikart/web",
    "typecheck:admin": "npm run typecheck --workspace=@mansoorikart/admin",
    "typecheck:ui": "npm run typecheck --workspace=@mansoorikart/ui",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,md}\" \"*.{js,json}\" \"docs/*.md\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,json,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,md}\" \"*.{js,json}\" \"docs/*.md\"",
    "lint": "npm run format:check"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prettier": "^3.3.3"
  }
}
