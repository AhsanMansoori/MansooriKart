# MansooriKart backend v1 (TypeScript) environment example.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Required by backend/src/config/env.ts (getConfig throws if either is missing):
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=<generate-a-long-random-secret>

# Optional (sensible defaults shown):
NODE_ENV=development
PORT=5000
# Frontend origin. Required in production.
FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed CORS origins.
CORS_ALLOWED_ORIGINS=
