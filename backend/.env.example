# MansooriKart backend environment.
#
# Copy to `backend/.env` and replace every placeholder. `.env` is git-ignored and must never
# be committed. This file lists exactly what the application reads: the runtime contract is
# declared in `backend/src/config/env.ts`, and `getConfig()` refuses to start when a required
# value is missing or malformed. Anything not listed here is not read by the backend.
#
# There is deliberately no GOOGLE_CLIENT_SECRET. Google sign-in verifies ID tokens against the
# public client id, so no client secret exists to leak. See `docs/AUTHENTICATION_ARCHITECTURE.md`.
# There is deliberately no AI, vector-database or payment-provider configuration.

# ---------------------------------------------------------------- required
# Connection string for the application database.
MONGO_URI=mongodb://127.0.0.1:27017/mansoorikart
# Signing key for MansooriKart session tokens. Generate a long random value, for example
# `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`.
# In production this must be at least 32 characters and must not still say "replace".
JWT_SECRET=replace_with_a_long_random_value

# ---------------------------------------------------------------- application
# `development` (default), `test` or `production`. Production enables the strict checks below.
NODE_ENV=development
# HTTP port. Defaults to 5000.
PORT=5000
# Browser origin of the storefront. Required in production, and must be https there unless
# it is loopback. Also the base for links the API generates.
FRONTEND_URL=http://localhost:5173
# Reported by the Super Admin health endpoint. Defaults to "unknown".
APP_VERSION=1.1.0

# ---------------------------------------------------------------- authentication
# Session token lifetime, as <number><s|m|h|d>. Defaults to 48h.
JWT_EXPIRES_IN=15m
# Public Google OAuth client id from the Google Cloud console, ending in
# `.apps.googleusercontent.com`. Leaving it empty disables Google sign-in; local email and
# password sign-in is unaffected. Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- security
# Extra browser origins allowed to call the API, comma separated. FRONTEND_URL is always
# allowed, and http://localhost:3000 and http://localhost:5173 are allowed outside production.
# Every entry must be an absolute origin, and https in production unless it is loopback.
CORS_ALLOWED_ORIGINS=
# Sliding window for authentication attempts, in minutes. Defaults to 15.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Maximum authentication attempts per window, per client address, per process. Defaults to 10
# in production and 100 elsewhere. The counter is process-local: see
# `docs/ENVIRONMENT_CONFIGURATION.md` for what that means behind more than one instance.
AUTH_RATE_LIMIT_MAX=

# ---------------------------------------------------------------- one-off scripts
# Read only by `npm run admin:bootstrap`, never by the server. Set them for that command and
# leave them unset in the deployed environment.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
